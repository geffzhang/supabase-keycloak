# ── Keycloak ────────────────────────────────────────────────────
# 对外 host：不带 scheme、不带 /auth、不带结尾斜杠
KEYCLOAK_HOST=kc.example.com
KEYCLOAK_REALM=supabase
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=

# 方案 B 用 public client（SPA 走 PKCE）；方案 A 才需要 secret
KEYCLOAK_CLIENT_ID=supabase
KEYCLOAK_CLIENT_SECRET=

# ── Supabase ────────────────────────────────────────────────────
# anon / service_role 的签名密钥。方案 B 下它不会被替换，而是被
# sync-jwks.sh 转成 oct 密钥并入 KEYCLOAK_JWKS。少了它未登录请求
# 和 Dashboard 会全线 401。
JWT_SECRET=

# 方案 A 才用得到
API_EXTERNAL_URL=https://supabase.example.com/auth/v1
SITE_URL=https://app.example.com

# ── 方案 B 专用 ─────────────────────────────────────────────────
# 由 scripts/sync-jwks.sh 自动写入（Keycloak 公钥 + 上面 JWT_SECRET 的
# oct 密钥）。不要手工粘贴，也不要提交进仓库。
KEYCLOAK_JWKS=

# ── 验证脚本用（可选）───────────────────────────────────────────
# 本地自测 Keycloak 走 http 时设 KC_SCHEME=http
# KC_SCHEME=https
